# Rust / Cargo
/target/
**/target/

# Tauri generated desktop capability schemas — regenerated on every build.
studdup/gen/schemas/

# Android: gen/android is committed for reproducible signed builds (AD-017), but its generated
# gradle build outputs — and the signing keystore — are never committed.
studdup/gen/android/app/build/
studdup/gen/android/.gradle/
studdup/gen/android/local.properties
studdup/gen/android/keystore.jks
studdup/gen/android/keystore.properties

# Node / Vite
node_modules/
ui/dist/

# Local databases (dev DB + the legacy relative-path fallback in paths.rs)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Built binaries / bundles — these belong under target/, never committed
*.exe
*.dll
*.so
*.dylib
*.pdb

# Design handoff bundle (Claude Design export) — local reference only, not versioned
design/

# Editors / IDEs / OS
.vs/
.vscode/
.idea/
.cache/
.DS_Store
